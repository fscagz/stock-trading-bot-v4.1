# Alpaca — broker account (order execution only; market data comes from IBKR)
APCA_API_KEY_ID=your_alpaca_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# IBKR IB Gateway connection (market data + scanner)
# Port 4001 = live trading gateway, 4002 = paper trading gateway
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID_STREAM=1
IBKR_CLIENT_ID_FETCHER=2
IBKR_CLIENT_ID_SCANNER=3

# --- Systematic factor pipeline (optional; unset = those factors unavailable) ---

# SimFin — point-in-time fundamentals for value/quality/growth factors.
# Free key at https://simfin.com/api/v2/ (free tier = annual statements).
# Without this, bot/data/simfin_loader.py cannot run and only price-based
# factors are testable. See research/2026-08-20_factor_study_results.md.
SIMFIN_API_KEY=

# EODHD — survivorship-bias-free historical S&P 500 constituents.
# https://eodhd.com ("All-World" plan). Used by bot/data/universe_eodhd.py.
# Without this, backtest universes are built from currently-active symbols
# only, which inflates long-only results.
EODHD_API_KEY=
BOT_USE_EODHD=false

# FRED — macro/regime series (VIX, yield spread, CPI). Free key at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
