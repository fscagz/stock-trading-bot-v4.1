# Alpaca — broker account (order execution only; market data comes from IBKR)
APCA_API_KEY_ID=your_alpaca_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# IBKR IB Gateway connection (market data + scanner)
# Port 4001 = live trading gateway, 4002 = paper trading gateway
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID_STREAM=1
IBKR_CLIENT_ID_FETCHER=2
IBKR_CLIENT_ID_SCANNER=3
